{
  "manifest_version": 3,
  "name": "Automação VITAI HIAM",
  "version": "0.1.0",
  "description": "Acesso ao VITAI HIAM e preparação para exportação de relatórios.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://hiam.vitai.care/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://hiam.vitai.care/*",
        "https://*.vercel.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}