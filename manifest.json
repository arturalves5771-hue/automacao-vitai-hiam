{
    "manifest_version": 3,
    "name": "Automação Vitai HIAM",
    "version": "2.0",
    "description": "Automação de relatórios do Vitai HIAM com navegação em árvore e salvamento em rede.",
    "permissions": [
        "tabs",
        "storage",
        "downloads"
    ],
    "host_permissions": [
        "https://hiam.vitai.care/*",
        "https://automacao-vitai.vercel.app/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://hiam.vitai.care/*",
                "https://automacao-vitai.vercel.app/*",
                "file:///*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
