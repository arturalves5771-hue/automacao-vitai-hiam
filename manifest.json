{
  "manifest_version": 3,
  "name": "Automação VITAI HIAM",
  "version": "0.6.2",
  "description": "Navega pelos relatórios do VITAI HIAM e exporta Emergência e Internação em sequência.",
  "permissions": ["tabs", "storage", "scripting", "downloads"],
  "host_permissions": ["https://hiam.vitai.care/*", "https://*.vercel.app/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://hiam.vitai.care/*", "https://*.vercel.app/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}